# Copy to .env for local configuration. Old S4 data paths remain compatible.
APP_ENV=development
VERSUS_HOST=127.0.0.1
DEVTOOL_PORT=4310
# Set a unique password of at least 16 characters before production/network use.
# YFFM_ADMIN_PASSWORD=
# YFFM_MATCH_ENGINE=v3
# YELLOWDOGS_LEAGUE_PATH=D:/your-private-data/yellowdogs-league.json
# VERSUS_ACCOUNTS_PATH=D:/your-private-data/versus-accounts.json
# Shard storage: cleanup at most once per minute, with bounded deletions.
# YDL_SHARD_CLEANUP_INTERVAL_MS=60000
# YDL_SHARD_GC_MAX_FILES=256
# YDL_SHARD_MAX_LOG_SEGMENTS=64
