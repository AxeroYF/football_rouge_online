  "traits": {
    "aerial-beacon": {
      "name": "打点激素",
      "summary": "身高+20cm,获得ST为主位置，头球能力提升",
      "eligibleRoleGroups": [
        "ANY"
      ],
      "rules": [
        {
          "hook": "attribute",
          "add": {
            "heading": 5,
            "jumping": 5,
            "pace": -2
          }
        }
      ]
    },
    "touchline-flywheel": {
      "name": "避雷针",
      "summary": "该球员在场上时，全队在雷暴天气不会被劈",
      "eligibleRoleGroups": [
        "ANY"
      ],
      "rules": [
        {
          "hook": "attribute",
          "add": {
            "pace": 3,
            "crossing": 4
          },
          "when": {
            "roleIsWide": true
          }
        }
      ]
    },
    "shadow-marker": {
      "name": "都是哥们",
      "summary": "该球员在场上时，自动和周围球员获得默契线",
      "eligibleRoleGroups": [
        "DEF",
        "MID",
        "ATT"
      ],
      "rules": [
        {
          "hook": "attribute",
          "add": {
            "marking": 4,
            "tackling": 4,
            "pace": -2
          }
        }
      ]
    },
    "set-piece-toolbox": {
      "name": "因凡蒂诺救救我",
      "summary": "该球员在场上时，如果遇到黑哨事件，视为11名阿根廷人",
      "eligibleRoleGroups": [
        "DEF",
        "MID",
        "ATT"
      ],
      "rules": [
        {
          "hook": "attribute",
          "add": {
            "setPieces": 7
          }
        }
      ]
    },
    "rain-boots": {
      "name": "反向晴天娃娃",
      "summary": "该球员在雨天、雷暴、雪天比赛时，综合能力值提升10%",
      "eligibleRoleGroups": [
        "ANY"
      ],
      "rules": [
        {
          "hook": "attribute",
          "add": {
            "agility": 4
          },
          "when": {
            "precipitationGte": 60
          }
        }
      ]
    },
    "sweeper-keeper": {
      "name": "本质大心脏",
      "summary": "该球员在比赛的75分钟后，综合能力值提升10%",
      "eligibleRoleGroups": [
        "ANY"
      ],
      "rules": [
        {
          "hook": "attribute",
          "add": {
            "passing": 5,
            "reflexes": -2
          }
        }
      ]
    },
    "lone-finisher": {
      "name": "变色龙",
      "summary": "该球员可以适配任何国家队或者俱乐部羁绊",
      "eligibleRoleGroups": [
        "ANY"
      ],
      "rules": [
        {
          "hook": "attribute",
          "add": {
            "finishing": 7,
            "composure": 7,
            "passing": -3
          }
        }
      ]
    },
    "big-stage": {
      "name": "跳水王子",
      "summary": "该球员造点球的概率提升，但是获得黄牌的概率也提升",
      "eligibleRoleGroups": [
        "ANY"
      ],
      "rules": [
        {
          "hook": "attribute",
          "add": {
            "decisions": 6,
            "composure": 6
          },
          "when": {
            "minuteGte": 70,
            "scoreState": [
              "tied",
              "trailing"
            ]
          }
        }
      ]
    },
    "opening-sprint": {
      "name": "铁血蓝白",
      "summary": "该球员所在球队使用伐木战术时，综合能力提升5%",
      "eligibleRoleGroups": [
        "ANY",
        "GK",
        "DEF",
        "MID",
        "ATT"
      ],
      "rules": [
        {
          "hook": "attribute",
          "add": {
            "pace": 7,
            "offBall": 7
          },
          "when": {
            "minuteLte": 20
          }
        },
        {
          "hook": "attribute",
          "add": {
            "pace": -3
          },
          "when": {
            "minuteGte": 65
          }
        }
      ]
    },
    "chameleon-role": {
      "name": "变色龙2",
      "summary": "出任任何位置时，位置适配最低为70%。",
      "eligibleRoleGroups": [
        "ANY"
      ],
      "rules": [
        {
          "hook": "position",
          "minimumFit": 0.7
        }
      ]
    },
    "stoppage-time-expert": {
      "name": "996",
      "summary": "该球员的体力值固定为90，不会随着比赛消耗变化。",
      "eligibleRoleGroups": [
        "ANY",
        "GK",
        "DEF",
        "MID",
        "ATT"
      ],
      "rules": [
        {
          "hook": "attribute",
          "add": {
            "composure": 8
          },
          "when": {
            "minuteGte": 85
          }
        }
      ]
    },
    "double-edged-core": {
      "name": "借过一下",
      "summary": "该球员的边路相关属性获得提升，解锁LW/RW位置的熟练度",
      "eligibleRoleGroups": [
        "ANY"
      ],
      "rules": [
        {
          "hook": "attribute",
          "add": {
            "vision": 6,
            "finishing": 4
          }
        },
        {
          "hook": "attribute",
          "add": {
            "decisions": -5
          },
          "when": {
            "fitnessLte": 40
          }
        }
      ]
    },
    "utility-player": {
      "name": "全能战士",
      "summary": "除门将外，出任任何陌生位置都不受到减益，都视为具有熟练度",
      "eligibleRoleGroups": [
        "DEF",
        "MID",
        "ATT"
      ],
      "rules": [
        {
          "hook": "position",
          "ignoreOutOfPositionPenalty": true,
          "eligibleRoleGroups": [
            "DEF",
            "MID",
            "ATT"
          ]
        }
      ]
    },
    "muddy-knees": {
      "name": "一夫当关",
      "summary": "该球员在比赛中一定会扑出对方主罚的第一粒点球",
      "eligibleRoleGroups": [
        "GK"
      ],
      "rules": [
        {
          "hook": "attribute",
          "add": {
            "tackling": 5
          },
          "when": {
            "precipitationGte": 35
          }
        }
      ]
    },
    "pace-budget": {
      "name": "普拉蒂尼是我爹",
      "summary": "该球员不会被红牌罚下",
      "eligibleRoleGroups": [
        "ANY"
      ],
      "rules": [
        {
          "hook": "attribute",
          "add": {
            "pace": -2
          },
          "when": {
            "minuteLte": 30
          }
        },
        {
          "hook": "attribute",
          "add": {
            "pace": 4,
            "stamina": 4
          },
          "when": {
            "minuteGte": 70
          }
        }
      ]
    }
  }
