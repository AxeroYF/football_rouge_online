{
  "name": "football-roguelite-simulator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node devtool/build.js",
    "demo": "node devtool/server.js",
    "public-demo": "node devtool/public-server.js",
    "tunnel": "node devtool/tunnel.js",
    "test-server": "node devtool/test-server.js",
    "test-tunnel": "node devtool/test-tunnel.js",
    "export:s4-player-metadata": "node devtool/export-s4-player-metadata-review.js",
    "merge:s4-player-database": "node devtool/merge-s4-player-database.js",
    "build:s4-player-candidates": "node devtool/build-s4-player-candidates.js",
    "apply:s4-player-localization": "node devtool/apply-s4-player-localization.js",
    "import:s4-final-workbook": "node devtool/import-s4-final-workbook.js",
    "import:s4-player-dlc": "node devtool/import-player-dlc-to-s4.js",
    "import:s4-dlc-profiles": "node devtool/import-player-dlc-profiles.js",
    "sync:a-player-profiles": "node devtool/sync-a-player-profiles.js",
    "optimize:player-profiles": "node devtool/optimize-player-profiles.js",
    "devtool": "node devtool/server.js",
    "simulate": "node src/cli.js --matches 10000 --seed demo",
    "balance:versus": "node versus/balance-report.js",
    "balance:versus:seeded": "node versus/balance-report.js --config=balance-config-seeded.json",
    "balance:versus:fast": "node versus/balance-report.js --config=balance-config-fast.json",
    "balance:versus:quick": "node versus/balance-report.js --quick",
    "balance:versus:render": "node versus/balance-report.js --render-only --quick",
    "balance:ydl:s2": "node versus/balance-report.js --config=balance-config-ydl-s2.json",
    "balance:ydl:s2:legends": "node versus/balance-report.js --config=balance-config-ydl-s2-legends.json",
    "balance:ydl:s4": "node versus/s4-balance-report.js",
    "balance:ydl:s4:parallel": "node versus/s4-balance-report-parallel.js",
    "balance:ydl:s4:medium": "node versus/s4-balance-report.js --config=s4-balance-config-medium.json",
    "balance:ydl:s4:medium:parallel": "node versus/s4-balance-report-parallel.js --config=s4-balance-config-medium.json",
    "balance:ydl:s4:fast": "node versus/s4-balance-report.js --config=s4-balance-config-fast.json",
    "balance:ydl:s4:fast:parallel": "node versus/s4-balance-report-parallel.js --config=s4-balance-config-fast.json",
    "compare:engine:v1-v2": "node versus/v2/engine-comparison-v2.js",
    "simulate:engine:v2": "node versus/v2/match-engine-v2-cli.js",
    "benchmark:engine:v2-server": "node versus/v2/server-pressure-benchmark-v2.js",
    "migrate:league:shards": "node devtool/migrate-league-to-shards.js",
    "simulate:economy": "node versus/economy-simulation.js --config=economy-simulation-config.json",
    "simulate:season:s3": "node versus/season-simulation.js --config=season-simulation-config-s3.json",
    "traits": "node src/trait-cli.js --seed demo --role ST",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
