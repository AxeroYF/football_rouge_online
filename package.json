{
  "name": "football-roguelite-europe-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "predev": "npm run build:three-vendor",
    "pretest": "node scripts/check-source.mjs",
    "check": "node scripts/build-map-assets.mjs --check && npm test",
    "build:territories": "node scripts/build-territory-data.mjs && node scripts/build-maritime-data.mjs && node scripts/build-campaign-boundaries.mjs && node scripts/build-territory-resources.mjs && node scripts/build-map-assets.mjs && node scripts/build-territory-resource-report.mjs",
    "test": "node scripts/run-tests.mjs",
    "sync:player-profiles": "node scripts/sync-player-profiles.mjs",
    "build:relief-regions": "python scripts/build-map-relief-regions.py",
    "build:relief-europe-detail": "python scripts/build-europe-dem-tiles.py",
    "build:relief-unified": "python scripts/build-unified-relief-pyramid.py",
    "build:map-assets": "node scripts/build-map-assets.mjs",
    "build:three-vendor": "node scripts/build-three-vendor.mjs",
    "build:map-environment": "python scripts/build-map-environment.py",
    "test:three": "node --check client/map-three/atlas-nature-model.js && node --check client/map-three/atlas-nature.js && node --check client/map-three/atlas-mountains.js && node --check client/map-three/atlas-terrain.js && node --check client/map-three/atlas-environment.js && node --check client/map-three/atlas-style.js && node --check client/map-three/atlas-ribbons.js && node --check client/map-three/atlas-shore.js && node --check client/map-three/preview.js && node --check client/map-three/campaign-layer.js && node --check client/map-three/tiles.js && node --test test/atlas-nature.test.js test/atlas-terrain.test.js test/map-three.test.js test/campaign-three.test.js test/map-environment.test.js test/terrain-profile.test.js test/relief-terrain.test.js test/wonder-models.test.js test/facility-models.test.js test/expedition-models.test.js",
    "build:relief:soft": "python scripts/build-soft-relief.py",
    "test:relief:build": "python -m unittest discover -s test -p test_soft_relief.py",
    "build:relief:mesh": "python scripts/build-relief-mesh.py",
    "build:map-nature": "python scripts/build-map-nature.py",
    "start": "node server.mjs",
    "build:resources": "node scripts/build-territory-resources.mjs && node scripts/build-map-assets.mjs && node scripts/build-territory-resource-report.mjs",
    "build:wonders": "node scripts/build-three-vendor.mjs && node scripts/build-wonder-models.mjs",
    "test:wonders": "node --test test/wonder-models.test.js",
    "review:wonders": "node scripts/review-wonder-models.mjs",
    "preview:wonders": "node scripts/serve-wonder-preview.mjs",
    "build:facilities": "node scripts/build-facility-models.mjs",
    "review:facilities": "node scripts/review-facility-models.mjs",
    "test:facilities": "node --test test/facility-models.test.js",
    "preview:facilities": "node scripts/serve-facility-preview.mjs",
    "build:expedition": "node scripts/build-expedition-models.mjs",
    "review:expedition": "node scripts/review-expedition-vehicles.mjs",
    "test:expedition": "node --test test/expedition-models.test.js test/expedition-appearance.test.js test/expedition-piece.test.js test/expedition-panel.test.js",
    "review:expedition-panel": "node scripts/review-expedition-panel.mjs",
    "review:scout-travel": "node scripts/review-scout-travel.mjs",
    "review:sponsorship": "node scripts/review-sponsorship.mjs",
    "test:sponsorship": "node --test test/sponsorship.test.js",
    "build:map-demo": "node scripts/build-map-style-demo.mjs",
    "preview:map-demo": "node scripts/serve-map-style-demo.mjs",
    "review:map-demo": "node scripts/review-map-style-demo.mjs",
    "review:world598": "node scripts/review-world598.mjs",
    "test:v21": "node --test test/v21-integration.test.js test/campaign-match-engine.test.js test/campaign-broadcast.test.js",
    "test:coalition": "node --test test/coalition.test.js",
    "test:fitness": "node --test test/expedition-fitness.test.js",
    "review:fitness": "node scripts/review-expedition-fitness.mjs",
    "preview:v22": "node scripts/serve-v22-preview.mjs",
    "review:v22": "node scripts/review-v22-preview.mjs",
    "test:v22": "node --test test/v22-hybrid.test.js test/v22-football-rules.test.js test/v22-board-tactics.test.js",
    "test:league-dynamic": "node --test test/league-dynamic.test.js test/daily-league.test.js test/daily-league-service.test.js test/league-registration.test.js",
    "review:league-dynamic": "node scripts/review-league-dynamic.mjs"
  },
  "devDependencies": {
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1"
  },
  "dependencies": {
    "three": "0.185.1",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/helpers": "^7.4.0"
  }
}
